# name: test/sql/tera.test
# description: test tera extension
# group: [sql]

# Before we load the extension, this will fail
statement error
SELECT tera_render('');
----
Catalog Error: Scalar Function with name tera_render does not exist!

# Require statement will ensure this test is run with this extension loaded
require tera

# Render the template with a JSON context as the second argument
query T
SELECT tera_render('{{ foo }}', '{"foo": "bar"}')
----
bar

# Demonstrate that rendering without a context is possible, but if you
# reference unknown variables an error will be raised.
statement error
SELECT tera_render('{{ foo }}')
----
Invalid Input Error: Error rendering template: Tera render error: Failed to render '__tera_one_off'
Caused by: Variable `foo` not found in context while rendering '__tera_one_off'

# Demonstrate that by default autoescaping is applied.
query T
SELECT tera_render('{{ v }}', '{"v": "B&O"}')
----
B&amp;O

# Test that autoescaping can be disabled.
query T
SELECT tera_render('{{ v }}', '{"v": "B&O"}', autoescape := false)
----
B&O

# NOTE: loading templates from files on disk (template_path) is exercised in
# tera.test_slow — it needs host filesystem access, which the wasm build does
# not have, so it is kept out of the default suite.

require json

statement ok
CREATE TABLE render_data (v JSON)

statement ok
INSERT INTO render_data values ('{"color": "red"}'),  ('{"color": "blue"}');

query T
SELECT tera_render('{{color}}', v) from render_data order by 1;
----
blue
red

# The options are keyword-only parameters with defaults; duckdb_functions()
# lists them after the positional arguments of each overload.
query III
SELECT function_name, parameters, parameter_types
FROM duckdb_functions()
WHERE function_name = 'tera_render'
ORDER BY len(parameters)
----
tera_render	[template, autoescape, template_path, autoescape_extensions]	[VARCHAR, BOOLEAN, VARCHAR, 'VARCHAR[]']
tera_render	[template, context, autoescape, template_path, autoescape_extensions]	[VARCHAR, JSON, BOOLEAN, VARCHAR, 'VARCHAR[]']

query II
SELECT description IS NOT NULL, categories
FROM duckdb_functions()
WHERE function_name = 'tera_render'
ORDER BY len(parameters)
----
true	[text, template]
true	[text, template]

# The positional arguments can also be passed by name, in any order.
query T
SELECT tera_render(context := '{"a": 1}', template := '{{ a }}')
----
1

# Explicitly passing the defaults matches the default behavior.
query T
SELECT tera_render('{{ v }}', '{"v": "B&O"}', autoescape := true, template_path := '', autoescape_extensions := [])
----
B&amp;O

# Options work for the overload without a context too.
query T
SELECT tera_render('{{ "B&O" }}', autoescape := false)
----
B&O

query T
SELECT tera_render('{{ "B&O" }}')
----
B&amp;O

# Unknown option names are rejected.
statement error
SELECT tera_render('Hello', bogus := 1)
----
No function matches the given name and argument types 'tera_render(STRING_LITERAL, "bogus" := INTEGER_LITERAL)'

statement error
SELECT tera_render('Hello', '{}', autoescap := false)
----
No function matches the given name and argument types

# The options are typed: values that cannot be cast implicitly are rejected.
statement error
SELECT tera_render('Hello', autoescape := 1)
----
No function matches the given name and argument types 'tera_render(STRING_LITERAL, "autoescape" := INTEGER_LITERAL)'

statement error
SELECT tera_render('Hello', '{}', autoescape_extensions := [1, 2])
----
No function matches the given name and argument types

# String literals are cast to the declared type.
query T
SELECT tera_render('{{ v }}', '{"v": "B&O"}', autoescape := 'false')
----
B&O

# The options must be constants.
statement error
SELECT tera_render('Hello', autoescape := random() > 0.5)
----
must be a constant expression

statement error
SELECT tera_render('Hello', autoescape_extensions := ['html', NULL])
----
Binder Error: tera_render: 'autoescape_extensions' must not contain NULL

# Options are keyword-only: they cannot be passed by position.
statement error
SELECT tera_render('Hello', '{}', false)
----
No function matches the given name and argument types

# tera_render uses default NULL handling: a NULL argument, including a NULL
# option, makes the result NULL.
query T
SELECT tera_render('x', autoescape := NULL)
----
NULL
